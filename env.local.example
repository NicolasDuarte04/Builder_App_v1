
# ---------------------------------------------------------------------------
# AUTH / NEXTAUTH (local dev URL recommended)
# ---------------------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=your-nextauth-secret-here

# ---------------------------------------------------------------------------
# SUPABASE (server-only keys)
# ---------------------------------------------------------------------------
# Public (browser) — used by client-side libraries:
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only (never expose to client):
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# FEATURE FLAGS (for debugging or phased rollouts)
# ---------------------------------------------------------------------------
# If '1', forces the /api/ai/chat route to return plain JSON instead of streaming SSE.
# Useful for debugging or for browsers with quirky stream parsing (e.g. Safari).
# The client will branch on Content-Type, so both modes are supported.
NEXT_PUBLIC_FORCE_NOSTREAM=0

# ---------------------------------------------------------------------------
# OBSERVABILITY (diagnostics only)
# ---------------------------------------------------------------------------
# Set to true in prod to record thin result events. Defaults to false.
# LOG_THIN_RESULTS=false

# When set to '1' locally, allows writing CSV/markdown files under ./reports
# Guarded: disables on Vercel/Edge/production regardless unless explicitly enabled and running locally
# BRIKI_ENABLE_FILE_LOGS=1
